{
  "name": "agent-voxel-world",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --filter @voxel/server dev\" \"pnpm --filter @voxel/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "voice:setup": "node scripts/setup-local-voice.mjs",
    "db:start": "node scripts/database.mjs",
    "db:stop": "node scripts/database.mjs stop",
    "db:generate": "pnpm --filter @voxel/server exec prisma generate",
    "db:migrate": "pnpm --filter @voxel/server exec dotenv -e ../../.env -- prisma migrate deploy",
    "agent": "pnpm --filter @voxel/agent start",
    "test:integration": "pnpm --filter @voxel/agent test:integration",
    "format": "prettier --write apps packages scripts tests README.md docs package.json tsconfig.json pnpm-workspace.yaml",
    "format:check": "prettier --check apps packages scripts tests README.md docs package.json tsconfig.json pnpm-workspace.yaml",
    "agent:deepseek": "pnpm --filter @voxel/agent deepseek",
    "test:agent:deepseek": "pnpm --filter @voxel/server test:agent:deepseek"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
