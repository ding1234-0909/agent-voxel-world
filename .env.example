# PostgreSQL for this project only; start using pnpm db:start
DATABASE_URL=postgresql://voxel:voxel@127.0.0.1:55432/voxel?schema=public
PORT=2567
# Optional when running the web app on a different local port.
# WEB_ORIGIN=http://127.0.0.1:5173

# Default for SDK clients without a provider; the web UI selects explicitly.
VOICE_PROVIDER=mock
# Optional local AI: install Ollama and pull a LOCAL model, then uncomment.
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional overrides for local speech recognition. Default model: .data/voice/ggml-base.bin
# Install model using pnpm voice:setup. Executables must be on the server PATH.
# WHISPER_MODEL=/absolute/path/to/ggml-base.bin
# WHISPER_BIN=whisper-cli
# FFMPEG_BIN=ffmpeg

# Agent spatial replies use server-local macOS say + ffmpeg (no cloud TTS).
# TTS_VOICE_ZH=Tingting
# TTS_VOICE_EN=Samantha

# DeepSeek AI player (separate local Agent process; never use VITE_ for secrets).
# DEEPSEEK_API_KEY=your-key
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MAX_TOKENS=512
# DEEPSEEK_TIMEOUT_MS=30000
# SERVER_URL=ws://127.0.0.1:2567
# AGENT_NAME=DeepSeek
# AGENT_GOAL=探索附近环境，用中文介绍观察结果。
# 每个任务的保护上限；不代表必须执行的轮数。旧 AGENT_CONTINUOUS 不再绕过预算。
# AGENT_MAX_TURNS=100
# AGENT_TOKEN_BUDGET=50000
# AGENT_TASK_TIMEOUT_MS=900000
# AGENT_INTERVAL_MODE=fixed
# AGENT_INTERVAL_MIN_MS=4000
# AGENT_INTERVAL_MAX_MS=8000
# AGENT_INTERVAL_MS=3000
# AGENT_ALLOW_EDITS=false
# AGENT_VOICE_REPLIES=false
